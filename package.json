{
	"name": "ostraka",
	"version": "1.139.11",
	"private": true,
	"description": "Ostraka: a living Shatterlands simulation played with the B.R.U.T.A.L. TTRPG system. Originally forked from Azgaar's Fantasy Map Generator (MIT).",
	"license": "MIT",
	"main": "main.js",
	"scripts": {
		"dev": "npm --prefix simulation-engine run observer",
		"observer": "npm --prefix simulation-engine run observer",
		"engine": "npm --prefix simulation-engine run dev",
		"start": "npm --prefix simulation-engine run start",
		"start:engine": "npm --prefix simulation-engine run start",
		"build": "npm --prefix simulation-engine run build:server && npm --prefix simulation-engine run build:observer",
		"build:engine": "npm --prefix simulation-engine run build:server",
		"build:observer": "npm --prefix simulation-engine run build:observer",
		"lint": "biome check --write"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.6",
		"@playwright/test": "^1.57.0",
		"@types/d3": "^7.4.3",
		"@types/delaunator": "^5.0.3",
		"@types/lineclip": "^2.0.0",
		"@types/node": "^25.0.10",
		"@types/polylabel": "^1.1.3",
		"@types/three": "^0.184.1",
		"@vitest/browser": "^4.1.10",
		"@vitest/browser-playwright": "^4.0.18",
		"playwright": "^1.57.0",
		"simple-git-hooks": "^2.13.1",
		"typescript": "^5.9.3",
		"vite": "^8.0.16",
		"vitest": "^4.0.18"
	},
	"dependencies": {
		"alea": "^1.0.1",
		"d3": "^7.9.0",
		"delaunator": "^5.0.1",
		"driver.js": "^1.4.0",
		"flatqueue": "^3.1.0",
		"lineclip": "^2.0.0",
		"polylabel": "^2.0.1",
		"three": "^0.184.0"
	},
	"engines": {
		"node": ">=20.0.0"
	}
}
